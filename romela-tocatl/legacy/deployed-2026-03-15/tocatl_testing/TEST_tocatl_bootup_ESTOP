# -------------------------------------------------------
# Dispatcher and Notifiers
# -------------------------------------------------------

def dispatch_message0(msg):
    for m in leftSideMotors:
        m.message_received(msg)

notifier0 = can.Notifier(bus0, [dispatch_message0])

def dispatch_message1(msg):
    for m in rightSideMotors:
        m.message_received(msg)

