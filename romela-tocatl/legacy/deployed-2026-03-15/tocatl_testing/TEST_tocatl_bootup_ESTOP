ESTOP = False

def estop(reason="KEYBOARD E-STOP"):
    global ESTOP
    if ESTOP:
        return
    ESTOP = True

    print("\n\n==============================")
    print(f"!!! {reason} ACTIVATED !!!")
    print("==============================\n")

    #Damp Motors
    for _ in range(3):
        for motor in allMotors:
            try:
                motor.control(position=0, velocity=0, torque=0, kp=0, kd=2.0)
            except Exception:
                pass
    

        
    #Kill Motors
    for _ in range(2):
        for motor in allMotors:
            try:
                motor.stop()
            except Exception:
                pass


    # Stop notifiers so no more RX callbacks happen
    try:
        notifier0.stop()
    except Exception:
        pass
    try:
        notifier1.stop()
    except Exception:
        pass

    # Shutdown buses
    try:
        bus0.shutdown()
    except Exception:
        pass
    try:
        bus1.shutdown()
    except Exception:
        pass

    print("Motors stopped, CAN shutdown. Exiting now.")
    os._exit(1)  # immediate exit even if you're in time.sleep()


def keyboard_estop_listener():
    print("\nVirtual E-Stop ARMED: type 'e' + Enter (or 'q') at any time.\n")
    while True:
        r, _, _ = select.select([sys.stdin], [], [], 0.05)
        if r:
            key = sys.stdin.readline().strip().lower()
            if key in ("e", "q", "estop", "stop"):
                estop("VIRTUAL E-STOP")

threading.Thread(target=keyboard_estop_listener, daemon=True).start()

