<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tocatl_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo simulation of the TOCATL hexapod with keyboard-driven walking (simulation only, no CAN)</description>
  <maintainer email="matthewhutchinson@ucla.edu">Matthew Hutchinson</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tocatl_kinematics</depend>
  <depend>tocatl_gait</depend>
  <depend>tocatl_diagnostics</depend>
  <!-- pip deps: mujoco, numpy, opencv-python (recording), pynput (teleop hold-to-move) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
